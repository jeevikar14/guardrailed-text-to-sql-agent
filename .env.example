# =========================================
# APP
# =========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# =========================================
# DATABASE (Docker Compose defaults)
# =========================================
# Full-privilege connection used ONLY for schema introspection / admin scripts.
DATABASE_URL=postgresql://app_admin:app_admin_pw@postgres:5432/text2sql

# Read-only connection used by the Safe Executor for actual query execution.
DATABASE_READONLY_URL=postgresql://app_readonly:app_readonly_pw@postgres:5432/text2sql

POSTGRES_DB=text2sql
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=app_admin_pw
POSTGRES_READONLY_USER=app_readonly
POSTGRES_READONLY_PASSWORD=app_readonly_pw

# =========================================
# LLM PROVIDER
# =========================================
# One of: gemini | groq | ollama
LLM_PROVIDER=gemini

# Verify current free-tier availability before changing this.
LLM_MODEL=gemini-3.6-flash

GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# =========================================
# EMBEDDINGS (local, always free)
# =========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =========================================
# VECTOR STORE
# =========================================
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=schema_docs

# =========================================
# GUARDRAIL LIMITS
# =========================================
MAX_ROWS=100
MAX_JOINS=3
MAX_SUBQUERIES=2
MAX_QUERY_DEPTH=3
QUERY_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# =========================================
# POLICY FILE
# =========================================
POLICY_PATH=./data/policies.yaml

# =========================================
# STREAMLIT
# =========================================
BACKEND_API_URL=http://localhost:8000
